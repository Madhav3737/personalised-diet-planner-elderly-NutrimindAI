# NutriMind AI - Environment Variables Configuration

# FastAPI Settings
PROJECT_NAME="NutriMind AI"
SECRET_KEY="supersecretkeychangeit48920384029384"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 Days

# Database Configuration
# Default PostgreSQL URL (used by docker-compose)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nutrimind"

# Set to true to fall back to a local SQLite database (nutrimind.db) if Postgres is not running
USE_SQLITE_FALLBACK=True
SQLITE_DATABASE_URL="sqlite+aiosqlite:///./nutrimind.db"

# LLM Configuration (OpenAI)
# Add your OpenAI API key here to enable dynamic GPT-4/GPT-4o recommendations.
# If left empty, the application falls back to a rules-based clinical planner.
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o"

# RAG Directories
VECTOR_DB_DIR="./embeddings"
DOCUMENTS_DIR="./documents"
